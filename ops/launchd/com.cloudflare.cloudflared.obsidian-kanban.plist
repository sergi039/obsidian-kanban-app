<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cloudflare.cloudflared.obsidian-kanban</string>
  <!-- kanban.cervantes50.com -> Cloudflare Access (owner address only, one-time PIN) -> Obsidian kanban 127.0.0.1:4000.
       Config and credentials: ~/.config/obsidian-kanban-tunnel/ (owner-only); managed by cloudflare/kanban_access_setup.py -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/cloudflared</string>
    <string>tunnel</string>
    <string>--config</string>
    <string>/Users/ss/.config/obsidian-kanban-tunnel/config.yml</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/ss/Library/Logs/cloudflared-obsidian-kanban.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ss/Library/Logs/cloudflared-obsidian-kanban.log</string>
</dict>
</plist>
